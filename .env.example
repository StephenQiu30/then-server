# Optional isolated Docker Compose profile only.
# Normal development uses the services already installed on macOS and does not
# need this file. If isolation is required, copy to `.env`, replace every
# placeholder, set mode 0600, and start the `isolated-env` profile.

POSTGRES_PASSWORD=replace-with-48-lowercase-hex-characters
MINIO_ROOT_PASSWORD=replace-with-48-lowercase-hex-characters
REDIS_PASSWORD=replace-with-48-lowercase-hex-characters
RABBITMQ_DEFAULT_PASS=replace-with-48-lowercase-hex-characters
