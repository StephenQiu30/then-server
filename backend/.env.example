# Copy to a local ignored file and replace credentials; the process does not source this file.
APP_ROLE=api
HTTP_ADDR=127.0.0.1:8080
# Local API documentation only; true requires a loopback HTTP_ADDR.
API_DOCS_ENABLED=false
# Loopback development may use false; every non-loopback HTTP_ADDR requires true.
SESSION_COOKIE_SECURE=false
# Optional account mail; complete all four values to enable. Use the 163 client authorization code, not the mailbox login password.
# Only implicit TLS to smtp.163.com:465 is allowed outside loopback tests.
ACCOUNT_MAIL_SMTP_ADDR=smtp.163.com:465
ACCOUNT_MAIL_FROM=
ACCOUNT_MAIL_AUTH_CODE=
# Base64url without padding of at least 32 random bytes; keep stable until pending challenges expire.
ACCOUNT_MAIL_KEY=
# HTTPS app link opened from verification and reset mail. Web/App handling remains a separate release gate.
ACCOUNT_MAIL_LINK_BASE=
# Image/model generation is closed by default. `local` is reserved for the
# zero-cost fixture/local-service POC; `remote` remains a gated intent only.
GENERATION_MODE=off
# Legacy fallback when GENERATION_MODE is omitted: false=off, true=remote.
GENERATION_ENABLED=false
# Keep false until 14-01 GATE/POC/WORKER are approved; true is fail-closed now.
GENERATION_PROVIDER_CALLS_ENABLED=false
# Optional loopback HTTP image service used only in local mode. Empty uses the
# deterministic fixture; no public URL or Codex CLI output is accepted.
GENERATION_LOCAL_IMAGE_ENDPOINT=
# These limits are required only when GENERATION_ENABLED=true.
GENERATION_CURRENCY=
GENERATION_MAX_CONCURRENT_TASKS=0
GENERATION_MAX_QUOTA_UNITS=0
GENERATION_MAX_BUDGET_MINOR_UNITS=0
GENERATION_MAX_SUBMISSION_ATTEMPTS=0
GENERATION_PROVIDER_TIMEOUT=0s
GENERATION_RETENTION=0s
DATABASE_URL=postgres://then:REPLACE_ME@127.0.0.1:5432/then?sslmode=disable
# Authentication rate-limit state only; local plaintext is restricted to loopback.
REDIS_URL=redis://127.0.0.1:6379/0
# Synthetic person-photo flow only. Keep false for real user traffic.
MEDIA_DEVELOPMENT_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_SECURE=false
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=then
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
STARTUP_TIMEOUT=5s
HEALTH_TIMEOUT=1s
SHUTDOWN_TIMEOUT=10s
