# Copy to a local ignored file and replace credentials; the process does not source this file.
APP_ROLE=api
HTTP_ADDR=127.0.0.1:8080
# Local API documentation only; true requires a loopback HTTP_ADDR.
API_DOCS_ENABLED=false
# Loopback development may use false; every non-loopback HTTP_ADDR requires true.
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgres://then:REPLACE_ME@127.0.0.1:5432/then?sslmode=disable
# Authentication rate-limit state only; local plaintext is restricted to loopback.
REDIS_URL=redis://127.0.0.1:6379/0
# Synthetic person-photo flow only. Keep false for real user traffic.
MEDIA_DEVELOPMENT_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_SECURE=false
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
STARTUP_TIMEOUT=5s
HEALTH_TIMEOUT=1s
SHUTDOWN_TIMEOUT=10s
